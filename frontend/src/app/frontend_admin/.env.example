# NODE_ENV is managed by Next.js (development/test/production); do not override it manually.
# Public frontend configuration. Do not add secrets or private API credentials here.
# Empty API base URL intentionally uses same-origin API routes.
NEXT_PUBLIC_API_BASE_URL=
# Demo mutations are disabled by default; enable only in non-production environments.
NEXT_PUBLIC_FRONTEND_DEMO_MODE=false
