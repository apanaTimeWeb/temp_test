{
  "name": "frontend-admin-v45",
  "private": true,
  "version": "45.0.0",
  "type": "module",
  "peerDependencies": {
    "@hookform/resolvers": "3.x",
    "@radix-ui/react-dialog": "1.x",
    "@radix-ui/react-select": "1.x",
    "@radix-ui/react-switch": "1.x",
    "@radix-ui/react-tabs": "1.x",
    "@tanstack/react-query": "5.x",
    "apexcharts": "3.x",
    "date-fns": "3.x",
    "lucide-react": "*",
    "next": "15.x",
    "next-intl": "*",
    "next-themes": "*",
    "nextjs-toploader": "*",
    "react": "*",
    "react-apexcharts": "1.x",
    "react-dom": "*",
    "react-hook-form": "7.x",
    "sonner": "*",
    "tailwindcss": "4.x",
    "zod": "3.x",
    "zustand": "5.x",
    "@tanstack/react-virtual": "3.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "test:e2e": "playwright test --config ../playwright.config.ts",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:quality": "npm run check:architecture && npm run check:env-contract && npm run check:scenarios && npm run check:scenario-runtime && npm run check:query-keys && npm run check:boundaries && npm run check:boundaries:negative && npm run check:tokens && npm run check:feature-styles && npm run check:feature-styles:negative && npm run check:motion-safety && npm run check:motion-safety:negative && npm run check:finance-style-ownership && npm run check:type-isolation && npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:unsaved-changes && npm run check:duplicate-class-tokens && npm run check:duplicate-class-tokens:negative",
    "prepare": "husky",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "check:boundaries:negative": "node scripts/check-architecture-negative-tests.mjs",
    "check:tokens": "node scripts/check-css-token-contract.mjs",
    "check:feature-styles": "node scripts/check-feature-style-migration.mjs",
    "check:type-isolation": "node scripts/check-type-isolation.mjs",
    "check:scenarios": "node scripts/check-mock-scenario-registries.mjs",
    "check:query-keys": "node scripts/check-query-key-registries.mjs",
    "check:scenario-runtime": "node scripts/check-scenario-catalog-runtime.mjs",
    "check:finance-style-ownership": "node scripts/check-finance-style-ownership.mjs",
    "check:feature-styles:negative": "node scripts/check-feature-style-migration-negative-tests.mjs",
    "check:motion-safety": "node scripts/check-motion-safety.mjs",
    "check:motion-safety:negative": "node scripts/check-motion-safety-negative-tests.mjs",
    "check:duplicate-class-tokens": "node scripts/check-duplicate-class-tokens.mjs",
    "check:duplicate-class-tokens:negative": "node scripts/check-duplicate-class-tokens-negative-tests.mjs",
    "check:env-contract": "node scripts/check-env-contract.mjs",
    "check:unsaved-changes": "node scripts/check-unsaved-changes-coverage.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.0",
    "vitest": "^3.1.1",
    "msw": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.23.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "@tanstack/react-virtual": "3.x"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css,mjs}": [
      "prettier --write"
    ]
  }
