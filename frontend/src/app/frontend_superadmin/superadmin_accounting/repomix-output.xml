<file path="accounting_daily_settlement/hooks/useSuperadminAccountingDailySettlementConfirm.ts">
// RESPONSIBILITY: Own module-local state or interaction logic for accounting daily settlement; it does not imply persistence beyond verified contracts.
// FLOW: Feature component -> superadmin_accounting/accounting_daily_settlement/hooks/useSuperadminAccountingDailySettlementConfirm.ts -> local state/typed dependencies -> returned state and actions.
"use client";
/** Leaf-local accessible confirmation dialog hook. No backend/API behavior is inferred here. */
import { AlertTriangle } from 'lucide-react';
import { useTranslations } from 'next-intl';
import { createElement, useCallback } from 'react';
import { createRoot } from 'react-dom/client';

/**
 * Defines the public SuperadminAccountingDailySettlementConfirmOptions contract for accounting daily settlement. Optionality and nullability follow the declared fields; no additional backend guarantees are implied.
 * @property title Display label for the owning feature. Declared type: string.
 * @property confirmLabel Display label for the owning feature. Declared type: string.
 * @property cancelLabel Boolean state used by the owning feature. Declared type: string.
 * @property destructive Value defined by the existing feature-local contract. Declared type: boolean.
 */
export type SuperadminAccountingDailySettlementConfirmOptions = {
  title?: string;
  confirmLabel?: string;
  cancelLabel?: string;
  destructive?: boolean;
};

/** Uses the native modal-dialog focus/keyboard model with design-system semantic tokens. 
 * @returns The module-owned state/actions or utility result consumed by the caller.
 */
export function useSuperadminAccountingDailySettlementConfirm() {
  const t = useTranslations('SUPERADMIN_ACCOUNTING');
  return useCallback((message: string, options: SuperadminAccountingDailySettlementConfirmOptions = {}): Promise<boolean> =>
    new Promise<boolean>((resolve) => {
      if (typeof document === 'undefined') {
        resolve(false);
        return;
      }

      const previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      const destructive = options.destructive ?? /\b(delete|remove|revoke|suspend|terminate|settle|reset|restore|disable|permanent)\b/i.test(message);
      const dialog = document.createElement('dialog');
      const instanceId = `superadmin-confirm-${Date.now()}-${document.querySelectorAll('dialog[data-superadmin-confirm]').length + 1}`;
      const titleId = `${instanceId}-title`;
      const descriptionId = `${instanceId}-description`;
      dialog.dataset.superadminConfirm = 'true';
      dialog.className = 'm-auto sa-confirm-dialog max-w-lg rounded-xl border border-border bg-overlay p-0 text-primary shadow-dialog ';
      dialog.setAttribute('aria-labelledby', titleId);
      dialog.setAttribute('aria-describedby', descriptionId);
      dialog.setAttribute('aria-modal', 'true');

      const panel = document.createElement('div');
      panel.className = 'space-y-5 p-6 bg-overlay rounded-xl border border-border shadow-dialog w-full max-w-lg';
      const heading = document.createElement('h2');
      heading.id = titleId;
      heading.className = 'text-lg font-semibold text-primary';
      heading.textContent = options.title || t('COPY.CONFIRM_DIALOG_TITLE');
      let warningRoot: ReturnType<typeof createRoot> | undefined;
      if (destructive) {
        const warningIcon = document.createElement('span');
        warningIcon.className = 'inline-flex h-5 w-5 shrink-0 text-danger';
        warningIcon.setAttribute('aria-hidden', 'true');
        warningRoot = createRoot(warningIcon);
        warningRoot.render(createElement(AlertTriangle, { size: 18, strokeWidth: 2, 'aria-hidden': true }));
        heading.prepend(warningIcon);
      }
      const body = document.createElement('p');
      body.id = descriptionId;
      body.className = 'text-sm leading-6 text-secondary';
      body.textContent = message;
      const actions = document.createElement('div');
      actions.className = 'flex flex-wrap justify-end gap-3';
      const cancelButton = document.createElement('button');
      cancelButton.type = 'button';
      cancelButton.className = 'inline-flex min-h-11 items-center justify-center rounded-md border border-border bg-card px-4 py-2 text-sm font-medium text-primary hover:bg-surface-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary';
      cancelButton.textContent = options.cancelLabel || t('COPY.CONFIRM_DIALOG_CANCEL');
      const confirmButton = document.createElement('button');
      confirmButton.type = 'button';
      confirmButton.className = destructive
        ? 'inline-flex min-h-11 items-center justify-center rounded-md bg-danger px-4 py-2 text-sm font-semibold text-on-danger focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary'
        : 'inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-on-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary';
      confirmButton.textContent = options.confirmLabel || t('COPY.CONFIRM_DIALOG_CONTINUE');
      actions.append(cancelButton, confirmButton);
      panel.append(heading, body, actions);
      dialog.append(panel);

      const restoreFallbackBackground: Array<{ element: HTMLElement; inert: boolean; ariaHidden: string | null }> = [];
      const getFallbackFocusableElements = () => Array.from(dialog.querySelectorAll<HTMLElement>(
        'button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])',
      )).filter((element) => !element.hasAttribute('hidden') && element.getAttribute('aria-hidden') !== 'true');
      const handleFallbackKeyDown = (event: KeyboardEvent) => {
        if (event.key === 'Escape') { event.preventDefault(); finish(false); return; }
        if (event.key !== 'Tab') return;
        const focusable = getFallbackFocusableElements();
        if (focusable.length === 0) { event.preventDefault(); dialog.focus(); return; }
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      };
      const activateAccessibleFallback = () => {
        dialog.dataset.superadminConfirmFallback = 'true';
        dialog.setAttribute('role', 'dialog');
        dialog.setAttribute('tabindex', '-1');
        // Emulate the native modal overlay when showModal() is unavailable.
        dialog.className = 'sa-confirm-dialog-fallback fixed inset-0 m-0 h-screen w-screen max-w-none max-h-none flex items-center justify-center bg-overlay text-primary p-0';
        for (const child of Array.from(document.body.children)) {
          if (child === dialog || !(child instanceof HTMLElement)) continue;
          restoreFallbackBackground.push({ element: child, inert: child.hasAttribute('inert'), ariaHidden: child.getAttribute('aria-hidden') });
          child.setAttribute('inert', '');
          (child as HTMLElement & { inert: boolean }).inert = true;
          child.setAttribute('aria-hidden', 'true');
        }
        dialog.addEventListener('keydown', handleFallbackKeyDown);
        dialog.setAttribute('open', '');
      };
      const restoreAccessibleFallback = () => {
        dialog.removeEventListener('keydown', handleFallbackKeyDown);
        for (const saved of restoreFallbackBackground) {
          if (saved.inert) saved.element.setAttribute('inert', '');
          else { saved.element.removeAttribute('inert'); (saved.element as HTMLElement & { inert: boolean }).inert = false; }
          if (saved.ariaHidden === null) saved.element.removeAttribute('aria-hidden');
          else saved.element.setAttribute('aria-hidden', saved.ariaHidden);
        }
        restoreFallbackBackground.length = 0;
      };

      let settled = false;
      const finish = (approved: boolean) => {
        if (settled) return;
        settled = true;
        try { if (dialog.open && typeof dialog.close === 'function') dialog.close(); } catch { /* DOM cleanup remains authoritative. */ }
        restoreAccessibleFallback();
        warningRoot?.unmount();
        dialog.remove();
        if (previousFocus?.isConnected) previousFocus.focus();
        resolve(approved);
      };
      cancelButton.addEventListener('click', () => finish(false));
      confirmButton.addEventListener('click', () => finish(true));
      dialog.addEventListener('cancel', (event) => { event.preventDefault(); finish(false); });
      dialog.addEventListener('click', (event) => { if (event.target === dialog) finish(false); });
      dialog.addEventListener('close', () => { if (!settled) finish(false); });
      document.body.append(dialog);
      let nativeModalOpened = false;
      try {
        if (typeof dialog.showModal === 'function') { dialog.showModal(); nativeModalOpened = true; }
      } catch {
        nativeModalOpened = false;
      }
      if (!nativeModalOpened) activateAccessibleFallback();
      cancelButton.focus();
    }), [t]);
}
</file>

<file path="accounting_daily_settlement/hooks/useSuperadminAccountingDailySettlementSemanticTableState.ts">
// FLOW: Feature component -> superadmin_accounting/accounting_daily_settlement/hooks/useSuperadminAccountingDailySettlementSemanticTableState.ts -> local state/typed dependencies -> returned state and actions.
/** Responsibility: use Superadmin Accounting Semantic Table State; owns the named module state/data-flow behavior and its cleanup/recovery contract. */
import { useEffect, useMemo, useRef, useState } from 'react';

/**
 * Owns the accounting daily settlement semantic table state lifecycle for accounting daily settlement, keeping feature state and side effects within this leaf.
 * @param args Input required by the declared feature contract. Declared type: { rowData?: readonly T[] | null; paginationPageSize: number; paginationEnabled?: boolean; }.
 
 * @returns The module-owned state/actions or utility result consumed by the caller.
 */
export function useSuperadminAccountingDailySettlementSemanticTableState<T extends object>(args: { rowData?: readonly T[] | null; paginationPageSize: number; paginationEnabled?: boolean }) {
  const { rowData, paginationPageSize, paginationEnabled = false } = args;
  const [sort, setSort] = useState<{ field: string; direction: 'asc' | 'desc' } | null>(null);
  const [page, setPage] = useState(0);
  const [filterText, setFilterText] = useState('');
  const [urlStateReady, setUrlStateReady] = useState(false);
  const skipUrlWriteRef = useRef(false);
  const sortedRows = useMemo(() => {
    const needle = filterText.trim().toLocaleLowerCase();
    const rows = [...(rowData ?? [])].filter((row) => !needle || Object.values(row as unknown as Record<string, unknown>).some((value) => String(value ?? '').toLocaleLowerCase().includes(needle)));
    if (!sort) return rows;
    return rows.sort((left, right) => {
      const a = (left as unknown as Record<string, unknown>)[sort.field];
      const b = (right as unknown as Record<string, unknown>)[sort.field];
      const comparison = typeof a === 'number' && typeof b === 'number' ? a - b : String(a ?? '').localeCompare(String(b ?? ''), undefined, { numeric: true, sensitivity: 'base' });
      return sort.direction === 'asc' ? comparison : -comparison;
    });
  }, [rowData, sort, filterText]);
  const pageCount = Math.max(1, Math.ceil(sortedRows.length / Math.max(1, paginationPageSize)));
  const urlPage = page;
  const filterTextRef = useRef(filterText);
  const lastFilterTextRef = useRef(filterText);
  filterTextRef.current = filterText;
  const urlPageRef = useRef(urlPage);
  urlPageRef.current = urlPage;
  // Effect contract: hydrate only this leaf's search/page query keys on mount and browser navigation; preserve all unrelated query state.
  useEffect(() => {
    const readUrlState = () => {
      const params = new URLSearchParams(window.location.search);
      const nextSearch = params.get('sa_accounting_daily_settlement_search') ?? '';
      const rawPage = params.get('sa_accounting_daily_settlement_page');
      const parsedPage = rawPage !== null && /^\d+$/.test(rawPage) ? Number(rawPage) : 0;
      const nextPage = Number.isSafeInteger(parsedPage) ? Math.max(0, parsedPage) : 0;
      if (nextSearch !== filterTextRef.current || nextPage !== urlPageRef.current) skipUrlWriteRef.current = true;
      setFilterText(nextSearch);
      setPage(nextPage);
    };
    readUrlState();
    setUrlStateReady(true);
    window.addEventListener('popstate', readUrlState);
    return () => window.removeEventListener('popstate', readUrlState);
  }, []);

  // Effect contract: keep this leaf's search and pagination reflected in the URL without creating a history entry per keystroke.
  useEffect(() => {
    if (!urlStateReady) return;
    if (skipUrlWriteRef.current) { lastFilterTextRef.current = filterText; skipUrlWriteRef.current = false; return; }
    const filterChanged = lastFilterTextRef.current !== filterText;
    lastFilterTextRef.current = filterText;
    const syncUrl = () => {
      const params = new URLSearchParams(window.location.search);
      if (filterText) params.set('sa_accounting_daily_settlement_search', filterText);
      else params.delete('sa_accounting_daily_settlement_search');
      if (urlPage > 0) params.set('sa_accounting_daily_settlement_page', String(urlPage));
      else params.delete('sa_accounting_daily_settlement_page');
      const query = params.toString();
      const nextUrl = `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`;
      const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;
      if (nextUrl !== currentUrl) window.history.replaceState(window.history.state, '', nextUrl);
    };
    if (filterChanged) {
      const timeoutId = window.setTimeout(syncUrl, 300);
      return () => window.clearTimeout(timeoutId);
    }
    syncUrl();
  }, [filterText, urlPage, urlStateReady]);
  // Keep the current page valid when filtering or data changes reduce the available page count.
  // Effect contract: clamp the current page to the valid range whenever pageCount changes; [pageCount] is the deliberate dependency boundary.
  useEffect(() => { setPage((current) => Math.max(0, Math.min(current, pageCount - 1))); }, [pageCount]);
  const visibleRows = paginationEnabled ? sortedRows.slice(page * paginationPageSize, (page + 1) * paginationPageSize) : sortedRows;
  return { sort, setSort, page, setPage, filterText, setFilterText, sortedRows, pageCount, visibleRows };
}
</file>

<file path="accounting_daily_settlement/hooks/useSuperadminAccountingDailySettlementUrlFilter.ts">
// RESPONSIBILITY: Own module-local state or interaction logic for accounting daily settlement; it does not imply persistence beyond verified contracts.
// FLOW: Feature component -> superadmin_accounting/accounting_daily_settlement/hooks/useSuperadminAccountingDailySettlementUrlFilter.ts -> local state/typed dependencies -> returned state and actions.
'use client';

import { useCallback, useEffect, useRef, useState } from 'react';

/** Builds a query string while preserving unrelated filter parameters. */
export function buildSuperadminAccountingFilterSearch<T extends string>(
  search: string,
  key: string,
  fallback: T,
  nextValue: T,
): string {
  const params = new URLSearchParams(search);
  if (nextValue === fallback) params.delete(key);
  else params.set(key, nextValue);
  return params.toString();
}

/**
 * Keeps a module-owned preview filter in the URL so refresh, sharing, and browser
 * back/forward preserve the current view. This hook changes URL state only; it
 * does not imply server persistence for the sample datasets.
 
 * @param key - Input supplied by the caller under the declared TypeScript contract.
 * @param fallback - Input supplied by the caller under the declared TypeScript contract.
 * @param allowedValues - Input supplied by the caller under the declared TypeScript contract.
 * @returns The module-owned state/actions or utility result consumed by the caller.
 */
export function useSuperadminAccountingDailySettlementUrlFilter<T extends string>(
  key: string,
  fallback: T,
  allowedValues?: readonly T[],
): readonly [T, (nextValue: T) => void] {
  const [value, setValueState] = useState<T>(fallback);
  const allowedValuesRef = useRef(allowedValues);
  allowedValuesRef.current = allowedValues;

  const readCurrentValue = useCallback((): T => {
    const candidate = new URLSearchParams(window.location.search).get(key);
    const allowed = allowedValuesRef.current;
    return candidate && (!allowed || allowed.includes(candidate as T)) ? candidate as T : fallback;
  }, [fallback, key]);

  // Effect contract: keep local filter state synchronized with browser back/forward navigation and remove the listener on cleanup; dependency set [readCurrentValue] is the deliberate re-run boundary.
  useEffect(() => {
    setValueState(readCurrentValue());
    const handlePopState = () => setValueState(readCurrentValue());
    window.addEventListener('popstate', handlePopState);
    return () => window.removeEventListener('popstate', handlePopState);
  }, [readCurrentValue]);

  const setValue = useCallback((nextValue: T) => {
    setValueState(nextValue);
    const query = buildSuperadminAccountingFilterSearch(window.location.search, key, fallback, nextValue);
    const nextUrl = `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`;
    window.history.replaceState(window.history.state, '', nextUrl);
  }, [fallback, key]);

  return [value, setValue] as const;
}
</file>

