           data-testid={`superadmin-accounting-accounting-expenses-delete-sample-expense-1-${getSuperadminInteractiveTestIdSuffix(params.data)}`}>
            <Trash2 size={14} />
          </button>
        </div>
      )
    }
  ];

  return (
