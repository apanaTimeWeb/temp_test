  const showFilter = defaultColDef?.filter !== false;
  return <div className={`overflow-x-auto ${className}`} role="region" aria-label={tCopy('COPY.TABLE_ARIA_LABEL')} tabIndex={0}>
    {showFilter && <div className="flex justify-end border-b border-border p-3"><label className="flex items-center gap-2 text-sm text-secondary"><span>{tCopy('COPY.TABLE_FILTER_ROWS')}</span><input type="search" value={filterText} onChange={(event) => { setFilterText(event.currentTarget.value); setPage(0); }} className="min-w-40 rounded-md border border-border bg-input px-3 py-2 text-primary" data-testid="superadmin-accounting-accounting-semantic-table-field-1" /></label></div>}
    <table className="sa-semantic-table w-full border-collapse text-left text-sm">
      <thead className="bg-card text-secondary"><tr>{columns.map((column, index) => {
        const field = column.field ?? `column-${index}`;
        const canSort = (column.sortable ?? defaultColDef?.sortable ?? true) && Boolean(column.field);
        const width = column.width ?? defaultColDef?.width;
        const minWidth = column.minWidth ?? defaultColDef?.minWidth;
        return <th key={field} scope="col" style={{ height: headerHeight }} className={`border-b border-border px-4 py-3 font-semibold ${getColumnWidthClass(width, minWidth, field)}`}>
          {canSort ? <button type="button" className="inline-flex items-center gap-1 text-left" onClick={() => { setSort((current) => current?.field === field ? { field, direction: current.direction === 'asc' ? 'desc' : 'asc' } : { field, direction: 'asc' }); setPage(0); }} aria-label={tCopy('COPY.TABLE_SORT_BY', { column: column.headerName ?? field })} data-testid={`superadmin-accounting-accounting-semantic-table-table-sort-by-2-${String(field)}`}>
            {column.headerName ?? field}{sort?.field === field ? (sort.direction === 'asc' ? ' ↑' : ' ↓') : ''}
          </button> : (column.headerName ?? field)}
        </th>;
      })}</tr></thead>
