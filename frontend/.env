# Authentication endpoints (root-relative paths)
NEXT_PUBLIC_AUTH_LOGIN_PATH=/api/auth/login
NEXT_PUBLIC_AUTH_SIGNUP_PATH=/api/auth/signup
NEXT_PUBLIC_AUTH_FORGOT_PASSWORD_PATH=/api/auth/forgot-password
NEXT_PUBLIC_AUTH_RESET_PASSWORD_PATH=/api/auth/reset-password

# Non-production demo fill control
NEXT_PUBLIC_AUTH_DEMO_FILL_ENABLED=true

